# ── Bot account ──────────────────────────────────────────────────────────
BOT_USERNAME=bot@example.com          # MS account email used for auth (mineflayer 'username')
MINECRAFT_VERSION=26.2                 # explicit protocol pin — never "auto" in production, see docs/architecture.md
                                       # must be a version `minecraft-data` actually has protocol
                                       # data for — check with `node -e "console.log(!!require('minecraft-data')(process.argv[1]))" <version>`
                                       # before bumping; a new Minecraft release is often supported
                                       # by mineflayer's auth/connect layer before minecraft-data
                                       # ships block/item/protocol tables for it, in which case
                                       # mineflayer throws "unsupported protocol version" immediately
                                       # at startup. 26.2 support currently ships via a local yalc
                                       # override (see package.json "overrides" +
                                       # PrismarineJS/minecraft-data#1298) rather than an upstream
                                       # minecraft-data release — drop the override once that PR
                                       # merges and a release includes it.

# ── Realm / server connection ───────────────────────────────────────────
CONNECTION_MODE=realm                 # "direct" | "realm"
# direct mode:
SERVER_HOST=
SERVER_PORT=25565
# realm mode (resolved natively by mineflayer/minecraft-protocol at connect time):
REALM_NAME=My Survival Realm          # exact realm name as it appears in the account's realm list

# ── Auth token cache ─────────────────────────────────────────────────────
MS_AUTH_PROFILES_FOLDER=./.minecraft-auth   # gitignored; cached MS device-code tokens

# ── LLM provider ─────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                # "anthropic" | "openai" | "openrouter"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-haiku-4-5
ANTHROPIC_MODEL_ESCALATION=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4.1-mini
# openrouter reuses the OpenAI adapter against https://openrouter.ai/api/v1 (same Chat Completions
# wire format) — swap OPENROUTER_MODEL_PRIMARY to any OpenRouter model slug to compare capability
# against Haiku without touching code. Tool-calling strictness still depends on the underlying
# model OpenRouter routes to. The Sonnet escalation tier stays Anthropic-only regardless of
# LLM_PROVIDER (see docs/architecture.md / modelRouter.ts).
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=anthropic/claude-haiku-4.5

# ── Chat behavior / cost control ────────────────────────────────────────
CHAT_TRIGGER_MODE=mention             # "mention" | "prefix" | "all"
CHAT_TRIGGER_PREFIX=!bot
CHAT_ALLOWLIST=                       # comma-separated usernames; empty = allow anyone on the realm
CHAT_COOLDOWN_MS=3000                 # per-user minimum gap between LLM-triggering messages

# ── Skill tuning ─────────────────────────────────────────────────────────
PATHFINDER_MAX_DISTANCE=128
COMBAT_AGGRESSION_RADIUS=8
DECISION_LOOP_MAX_ITERATIONS=6

# ── Reward-model data collection (see issue #11) ─────────────────────────
DATA_COLLECTION_ENABLED=false         # "true" | "false" — logs one JSONL record per skill call
BOT_DATA_DIR=./.bot-data              # gitignored; decision-ticks-YYYY-MM-DD.jsonl land here

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
